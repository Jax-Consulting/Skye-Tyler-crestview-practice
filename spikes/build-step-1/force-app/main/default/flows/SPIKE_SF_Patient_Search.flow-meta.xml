    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Set_Result_Count</name>
        <label>Set Result Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varN_ResultCount</assignToReference>
            <operator>AssignCount</operator>
